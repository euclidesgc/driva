generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// O novo topo da hierarquia (Projeto → Categorias → Conteúdos). Guarda só a
/// CHAVE da imagem (`imageKey`) no storage — o binário nunca entra no
/// Postgres (ver `src/storage/`). `id` CUID2 é o mesmo valor esperado no
/// header `x-project-id`. `onDelete: Restrict` em `Content.project` impede
/// apagar um projeto com conteúdos (o usuário esvazia antes).
model Project {
  id          String    @id @default(cuid(2))
  title       String
  description String?
  imageKey    String?   @map("image_key")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Chave que o app do cliente embarca para ler conteúdo publicado. É pública
  /// por natureza (vai no binário distribuído) e por isso **só** dá leitura do
  /// que está publicado — nunca escrita, nunca lista projetos.
  publishableKey String @unique @map("publishable_key")

  contents   Content[]
  categories Category[]

  @@index([archivedAt])
  @@map("projects")
}

/// Categoria de conteúdo, em árvore por `parentId` (auto-relação nullable).
/// Vive dentro de um `Project` (`onDelete: Restrict` — não se apaga um
/// projeto com categorias). Apagar um pai zera `parentId` dos filhos
/// (`SetNull`, a subárvore não cascateia exclusão); apagar uma categoria com
/// conteúdos é bloqueado (`Content.category` é `Restrict`, ver abaixo).
model Category {
  id        String     @id @default(cuid(2))
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  contents  Content[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@index([projectId, parentId])
  @@map("categories")
}

/// Um conteúdo SDUI. Rascunho × publicado: `draftSpec` é o que o editor lê e
/// grava a cada save; o que está "no ar" é uma `ContentVersion` imutável,
/// referenciada por `publishedVersionId` (null = nunca publicado). O backend
/// NÃO interpreta nenhum dos dois specs (JSONB opaco) — o kernel de validação
/// é Dart (`sdui_core`). Multi-tenant preparado por `projectId` (FK para
/// `Project`); `slug` é a referência técnica única por projeto. Novos
/// registros nascem com id CUID2; UUIDs legados permanecem válidos.
/// `categoryId` é obrigatório — todo conteúdo pertence a exatamente uma
/// categoria (a "Geral" por default); `nameNormalized` (lowercase + sem
/// acento, normalizado em Node) alimenta a busca `q` via ILIKE, sem depender
/// de extensão Postgres.
model Content {
  id                 String    @id @default(cuid(2))
  projectId          String    @map("project_id")
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  categoryId         String    @map("category_id")
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name               String
  nameNormalized     String    @map("name_normalized")
  slug               String
  description        String?
  draftSpec          Json      @map("draft_spec")
  draftUpdatedAt     DateTime  @map("draft_updated_at")
  publishedVersionId String?   @map("published_version_id")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  versions ContentVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, updatedAt(sort: Desc), id])
  @@map("contents")
}

/// Uma versão publicada, imutável, de um `Content`. Nasce só via
/// `ContentsService.publish` — nunca editada depois de criada. `onDelete:
/// Cascade` é um desvio consciente do padrão `Restrict` do resto do schema:
/// versão não é entidade de negócio independente, e apagar o conteúdo
/// precisa levar o histórico junto (senão a exclusão em cascata de projeto
/// do item 9e volta a travar). `publishedVersionId` em `Content` é uma FK
/// solta (sem `@relation` bidirecional) para evitar ciclo de criação — o
/// join é explícito no service. `createdBy` nasce nullable e fica sem uso
/// até o item 26 (autenticação) existir.
model ContentVersion {
  id        String   @id @default(cuid(2))
  contentId String   @map("content_id")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version   Int
  spec      Json
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([contentId, version])
  @@index([contentId, version(sort: Desc)])
  @@map("content_versions")
}
