{
  "specVersion": 2,
  "kind": "component",
  "id": "c-card",
  "name": "Card de oferta",
  "slug": "card-de-oferta",
  "params": [
    { "name": "titulo", "type": "text", "isList": false, "required": true },
    {
      "name": "corDeFundo",
      "type": "color",
